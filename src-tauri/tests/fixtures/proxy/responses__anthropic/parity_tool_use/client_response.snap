response.output_item.added {"type":"response.output_item.added","output_index":0,"item":{"id":"[generated-id:2]","type":"function_call","status":"in_progress","call_id":"toolu_p","name":"get_weather","arguments":""}}
response.function_call_arguments.delta {"type":"response.function_call_arguments.delta","item_id":"[generated-id:2]","output_index":0,"delta":"{\"city\":\"Tokyo\"}"}
response.function_call_arguments.done {"type":"response.function_call_arguments.done","item_id":"[generated-id:2]","output_index":0,"arguments":"{\"city\":\"Tokyo\"}"}
response.output_item.done {"type":"response.output_item.done","output_index":0,"item":{"id":"[generated-id:2]","type":"function_call","status":"completed","call_id":"toolu_p","name":"get_weather","arguments":"{\"city\":\"Tokyo\"}"}}
response.completed {"type":"response.completed","response":{"id":"[generated-id:1]","object":"response","created_at":"[timestamp]","status":"completed","model":"claude","output":[{"id":"[generated-id:2]","type":"function_call","status":"completed","call_id":"toolu_p","name":"get_weather","arguments":"{\"city\":\"Tokyo\"}"}],"usage":{"input_tokens":5,"output_tokens":4,"total_tokens":9,"output_tokens_details":{"reasoning_tokens":0}}}}

