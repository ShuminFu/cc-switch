# stream
message_start {"type":"message_start","message":{"id":"r_err","type":"message","role":"assistant","model":"gemini-2.5-pro","usage":{"input_tokens":3,"output_tokens":1}}}
content_block_start {"type":"content_block_start","index":0,"content_block":{"type":"text","text":""}}
