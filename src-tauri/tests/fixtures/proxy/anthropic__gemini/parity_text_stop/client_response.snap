---
source: tests/proxy_golden.rs
description: "The same text reply converted by the stream and non-stream paths yields identical content, stop_reason and usage."
---
# stream
message_start {"type":"message_start","message":{"id":"r_par","type":"message","role":"assistant","model":"gemini-2.5-pro","usage":{"input_tokens":10,"output_tokens":2}}}
content_block_start {"type":"content_block_start","index":0,"content_block":{"type":"text","text":""}}
content_block_delta {"type":"content_block_delta","index":0,"delta":{"type":"text_delta","text":"Same "}}
content_block_delta {"type":"content_block_delta","index":0,"delta":{"type":"text_delta","text":"answer"}}
content_block_stop {"type":"content_block_stop","index":0}
message_delta {"type":"message_delta","delta":{"stop_reason":"end_turn","stop_sequence":null},"usage":{"input_tokens":10,"output_tokens":4}}
message_stop {"type":"message_stop"}

# non-stream
{
  "id": "r_par",
  "type": "message",
  "role": "assistant",
  "content": [
    {
      "type": "text",
      "text": "Same answer"
    }
  ],
  "model": "gemini-2.5-pro",
  "stop_reason": "end_turn",
  "stop_sequence": null,
  "usage": {
    "input_tokens": 10,
    "output_tokens": 4
  }
}
