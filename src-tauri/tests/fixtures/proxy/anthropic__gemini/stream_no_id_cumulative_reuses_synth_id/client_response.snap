# stream
message_start {"type":"message_start","message":{"id":"r2","type":"message","role":"assistant","model":"gemini-2.5-pro","usage":{"input_tokens":4,"output_tokens":2}}}
content_block_start {"type":"content_block_start","index":0,"content_block":{"type":"tool_use","id":"[generated-id:1]","name":"get_weather"}}
content_block_delta {"type":"content_block_delta","index":0,"delta":{"type":"input_json_delta","partial_json":"{\"city\":\"Tokyo\",\"units\":\"c\"}"}}
content_block_stop {"type":"content_block_stop","index":0}
message_delta {"type":"message_delta","delta":{"stop_reason":"tool_use","stop_sequence":null},"usage":{"input_tokens":4,"output_tokens":5}}
message_stop {"type":"message_stop"}
