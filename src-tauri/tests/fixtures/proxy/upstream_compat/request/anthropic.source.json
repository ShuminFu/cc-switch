{
  "model": "claude-sonnet-4-5",
  "max_tokens": 2048,
  "tools": [
    {
      "name": "get_weather",
      "description": "Get the current weather for a city",
      "input_schema": {
        "type": "object",
        "properties": {
          "city": {
            "type": "string",
            "description": "City name"
          }
        },
        "required": [
          "city"
        ]
      }
    }
  ],
  "tool_choice": {
    "type": "auto"
  },
  "messages": [
    {
      "role": "user",
      "content": "What is the weather in Paris and Rome?"
    },
    {
      "role": "assistant",
      "content": [
        {
          "type": "text",
          "text": "Checking both cities."
        },
        {
          "type": "tool_use",
          "id": "toolu_01A",
          "name": "get_weather",
          "input": {
            "city": "Paris"
          }
        },
        {
          "type": "tool_use",
          "id": "toolu_01B",
          "name": "get_weather",
          "input": {
            "city": "Rome"
          }
        }
      ]
    },
    {
      "role": "user",
      "content": [
        {
          "type": "tool_result",
          "tool_use_id": "toolu_01A",
          "content": "18C and sunny"
        },
        {
          "type": "tool_result",
          "tool_use_id": "toolu_01B",
          "content": [
            {
              "type": "text",
              "text": "21C and cloudy"
            }
          ]
        }
      ]
    }
  ],
  "stream": true
}
