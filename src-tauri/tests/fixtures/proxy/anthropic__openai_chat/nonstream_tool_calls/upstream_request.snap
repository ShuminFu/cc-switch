---
source: tests/proxy_golden.rs
description: Assistant tool_calls become tool_use blocks with parsed input; tool_choice any maps to required.
---
{
  "model": "gpt-4o",
  "messages": [
    {
      "role": "user",
      "content": "What's the weather?"
    }
  ],
  "max_tokens": 1024,
  "tools": [
    {
      "type": "function",
      "function": {
        "name": "get_weather",
        "description": "Get weather info",
        "parameters": {
          "type": "object",
          "properties": {
            "location": {
              "type": "string"
            }
          }
        }
      }
    }
  ],
  "tool_choice": "required"
}
