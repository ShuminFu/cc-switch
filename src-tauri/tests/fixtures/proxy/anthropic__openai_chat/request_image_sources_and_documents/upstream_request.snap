---
source: tests/proxy_golden.rs
description: "Image sources and document blocks: a URL image keeps image_url.url, base64 images build a data URI, empty images are skipped, text documents become text parts, base64 PDFs become file parts, and URL documents become a placeholder."
---
{
  "model": "gpt-4o",
  "messages": [
    {
      "role": "user",
      "content": [
        {
          "type": "text",
          "text": "Compare these."
        },
        {
          "type": "image_url",
          "image_url": {
            "url": "https://example.com/a.png"
          }
        },
        {
          "type": "image_url",
          "image_url": {
            "url": "data:image/jpeg;base64,QUJDRA=="
          }
        },
        {
          "type": "text",
          "text": "[document: notes.txt]\nhello doc"
        },
        {
          "type": "file",
          "file": {
            "filename": "manual.pdf",
            "file_data": "data:application/pdf;base64,JVBERi0="
          }
        },
        {
          "type": "text",
          "text": "[document omitted: spec.pdf (https://example.com/spec.pdf)]"
        }
      ]
    }
  ],
  "max_tokens": 1024
}
