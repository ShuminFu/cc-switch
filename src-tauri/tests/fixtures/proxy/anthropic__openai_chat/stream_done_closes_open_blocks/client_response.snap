source: tests/proxy_golden.rs
description: "[DONE] without a preceding finish_reason closes the open text block before message_delta (end_turn) and message_stop."
---
# stream
message_start {"type":"message_start","message":{"id":"chatcmpl_done","type":"message","role":"assistant","model":"gpt-4o","usage":{"input_tokens":0,"output_tokens":0}}}
content_block_start {"type":"content_block_start","index":0,"content_block":{"type":"text","text":""}}
content_block_delta {"type":"content_block_delta","index":0,"delta":{"type":"text_delta","text":"hello"}}
content_block_stop {"type":"content_block_stop","index":0}
message_delta {"type":"message_delta","delta":{"stop_reason":"end_turn","stop_sequence":null},"usage":{"input_tokens":0,"output_tokens":0}}
message_stop {"type":"message_stop"}
