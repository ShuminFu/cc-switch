# stream
message_start {"type":"message_start","message":{"id":"resp_1","type":"message","role":"assistant","model":"gpt-5","usage":{"input_tokens":0,"output_tokens":0}}}
content_block_start {"type":"content_block_start","index":0,"content_block":{"type":"tool_use","id":"call_1","name":"exec"}}
content_block_delta {"type":"content_block_delta","index":0,"delta":{"type":"input_json_delta","partial_json":"{\"cmd\":"}}
error {"type":"error","error":{"type":"stream_truncated","message":"Responses upstream stream ended before a terminal event"}}
