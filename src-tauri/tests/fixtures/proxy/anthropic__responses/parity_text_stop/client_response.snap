---
source: tests/proxy_golden.rs
description: "The same text reply converts to the same Anthropic content, stop_reason and usage in stream and non-stream mode."
---
# stream
message_start {"type":"message_start","message":{"id":"resp_par","type":"message","role":"assistant","model":"gpt-5.4","usage":{"input_tokens":0,"output_tokens":0}}}
content_block_start {"type":"content_block_start","index":0,"content_block":{"type":"text","text":""}}
content_block_delta {"type":"content_block_delta","index":0,"delta":{"type":"text_delta","text":"Hi "}}
content_block_delta {"type":"content_block_delta","index":0,"delta":{"type":"text_delta","text":"there"}}
content_block_stop {"type":"content_block_stop","index":0}
message_delta {"type":"message_delta","delta":{"stop_reason":"end_turn","stop_sequence":null},"usage":{"input_tokens":5,"output_tokens":2,"cache_read_input_tokens":4}}
message_stop {"type":"message_stop"}

# non-stream
{
  "id": "resp_par",
  "type": "message",
  "role": "assistant",
  "content": [
    {
      "type": "text",
      "text": "Hi there"
    }
  ],
  "model": "gpt-5.4",
  "stop_reason": "end_turn",
  "stop_sequence": null,
  "usage": {
    "input_tokens": 5,
    "output_tokens": 2,
    "cache_read_input_tokens": 4
  }
}
