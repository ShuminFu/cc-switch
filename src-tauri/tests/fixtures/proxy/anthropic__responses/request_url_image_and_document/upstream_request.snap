---
source: tests/proxy_golden.rs
description: "Regression 650905a: URL images and URL documents become input_image / input_file parts."
---
{
  "model": "gpt-5",
  "input": [
    {
      "role": "user",
      "content": [
        {
          "type": "input_image",
          "image_url": "https://example.com/a.png"
        },
        {
          "type": "input_file",
          "file_url": "https://example.com/manual.pdf",
          "filename": "manual.pdf"
        }
      ]
    }
  ],
  "max_output_tokens": 1024
}
