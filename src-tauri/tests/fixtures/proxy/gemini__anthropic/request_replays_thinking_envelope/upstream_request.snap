---
source: tests/proxy_golden.rs
description: "A functionCall whose thoughtSignature carries the cc-switch thinking envelope replays the signed thinking block at the start of the assistant turn, so the tool-result continuation keeps Anthropic thinking enabled; client-provided ids pair functionResponse parts by id."
---
{
  "model": "claude-sonnet-4-5",
  "messages": [
    {
      "role": "user",
      "content": [
        {
          "type": "text",
          "text": "Summarize the README"
        }
      ]
    },
    {
      "role": "assistant",
      "content": [
        {
          "type": "thinking",
          "thinking": "Need the README.",
          "signature": "EqQBsigREPLAY"
        },
        {
          "type": "tool_use",
          "id": "toolu_R1",
          "name": "read_file",
          "input": {
            "absolute_path": "/README.md"
          }
        }
      ]
    },
    {
      "role": "user",
      "content": [
        {
          "type": "tool_result",
          "tool_use_id": "toolu_R1",
          "content": "# Project"
        }
      ]
    }
  ],
  "max_tokens": 24000,
  "thinking": {
    "type": "enabled",
    "budget_tokens": 8000
  },
  "tools": [
    {
      "name": "read_file",
      "input_schema": {
        "type": "object",
        "properties": {
          "absolute_path": {
            "type": "string",
            "description": "Absolute path"
          },
          "offset": {
            "type": [
              "number",
              "null"
            ]
          },
          "limit": {
            "type": "number"
          }
        },
        "required": [
          "absolute_path"
        ]
      },
      "description": "Reads a file from the local filesystem."
    },
    {
      "name": "run_shell_command",
      "input_schema": {
        "type": "object",
        "properties": {
          "command": {
            "type": "string"
          },
          "directory": {
            "type": "string"
          }
        },
        "required": [
          "command"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "description": "Runs a shell command."
    }
  ]
