---
source: tests/proxy_golden.rs
description: Signed thinking and redacted thinking are packed into the thoughtSignature of the first functionCall (the thinking text is also shown as a thought part) so the next tool-result request can replay them; a positive thinkingBudget enables Anthropic thinking without sampling parameters.
---
{
  "model": "claude-sonnet-4-5",
  "messages": [
    {
      "role": "user",
      "content": [
        {
          "type": "text",
          "text": "List the repo"
        }
      ]
    }
  ],
  "max_tokens": 20000,
  "thinking": {
    "type": "enabled",
    "budget_tokens": 6000
  },
  "tools": [
    {
      "name": "read_file",
      "input_schema": {
        "type": "object",
        "properties": {
          "absolute_path": {
            "type": "string",
            "description": "Absolute path"
          },
          "offset": {
            "type": [
              "number",
              "null"
            ]
          },
          "limit": {
            "type": "number"
          }
        },
        "required": [
          "absolute_path"
        ]
      },
      "description": "Reads a file from the local filesystem."
    },
    {
      "name": "run_shell_command",
      "input_schema": {
        "type": "object",
        "properties": {
          "command": {
            "type": "string"
          },
          "directory": {
            "type": "string"
          }
        },
        "required": [
          "command"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "description": "Runs a shell command."
    }
  ]
}
