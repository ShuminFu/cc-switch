---
source: tests/proxy_golden.rs
description: "An Anthropic overloaded_error event mid-stream flushes the pending text frame and ends the stream with a Gemini error frame (503 UNAVAILABLE), without a finishReason."
---
{
  "model": "claude-sonnet-4-5",
  "messages": [
    {
      "role": "user",
      "content": [
        {
          "type": "text",
          "text": "hello"
        }
      ]
    }
  ],
  "max_tokens": 8192,
  "stream": true
}
