---
source: tests/proxy_golden.rs
description: "Gemini Schema tool declarations (upper-case types, nullable) become JSON Schema tools, built-in tools are dropped and toolConfig ANY with one allowed name forces that tool; the tool_use reply becomes a functionCall that carries the Anthropic id."
---
{
  "model": "claude-sonnet-4-5",
  "messages": [
    {
      "role": "user",
      "content": [
        {
          "type": "text",
          "text": "Read /tmp/a.txt"
        }
      ]
    }
  ],
  "max_tokens": 8192,
  "tools": [
    {
      "name": "read_file",
      "input_schema": {
        "type": "object",
        "properties": {
          "absolute_path": {
            "type": "string",
            "description": "Absolute path"
          },
          "offset": {
            "type": [
              "number",
              "null"
            ]
          },
          "limit": {
            "type": "number"
          }
        },
        "required": [
          "absolute_path"
        ]
      },
      "description": "Reads a file from the local filesystem."
    },
    {
      "name": "run_shell_command",
      "input_schema": {
        "type": "object",
        "properties": {
          "command": {
            "type": "string"
          },
          "directory": {
            "type": "string"
          }
        },
        "required": [
          "command"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "description": "Runs a shell command."
    }
  ],
  "tool_choice": {
    "type": "tool",
    "name": "read_file"
  }
}
