---
source: tests/proxy_golden.rs
description: "Parallel tool_use blocks whose input arrives as input_json_delta fragments are emitted as complete functionCall frames when each block stops, in block order."
---
{
  "model": "claude-sonnet-4-5",
  "messages": [
    {
      "role": "user",
      "content": [
        {
          "type": "text",
          "text": "read both"
        }
      ]
    }
  ],
  "max_tokens": 8192,
  "stream": true,
  "tools": [
    {
      "name": "read_file",
      "input_schema": {
        "type": "object",
        "properties": {
          "absolute_path": {
            "type": "string",
            "description": "Absolute path"
          },
          "offset": {
            "type": [
              "number",
              "null"
            ]
          },
          "limit": {
            "type": "number"
          }
        },
        "required": [
          "absolute_path"
        ]
      },
      "description": "Reads a file from the local filesystem."
    },
    {
      "name": "run_shell_command",
      "input_schema": {
        "type": "object",
        "properties": {
          "command": {
            "type": "string"
          },
          "directory": {
            "type": "string"
          }
        },
        "required": [
          "command"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "description": "Runs a shell command."
    }
  ]
}
