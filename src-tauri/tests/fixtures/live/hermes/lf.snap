=== .hermes/config.yaml ===
# Hermes config written by the user
model:
  default: gpt-5
  provider: custom

# A comment that belongs to the custom_providers section
custom_providers:
- name: existing
  base_url: https://existing.example.com/v1
  api_key: existing-key
  rate_limit_delay: 0.5
- base_url: https://relay.example.com/v1
  api_key: sk-provider-new
  api_mode: chat_completions
  models:
    gpt-5:
      context_length: 400000
  name: relay
  model: gpt-5
mcp_servers:
  docs:
    command: uvx
    args: [docs-mcp]   # inline comment

future_hermes_key:
  nested: true
