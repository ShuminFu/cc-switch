=== .gemini/.env ===
# Gemini env written by the user
GEMINI_API_KEY=sk-provider-new
GOOGLE_GEMINI_BASE_URL=https://relay.example.com
GEMINI_MODEL=gemini-2.5-pro
<no newline at end of file>
=== .gemini/settings.json ===
{
  "mcpServers": {
    "docs": {
      "command": "uvx",
      "args": [
        "docs-mcp"
      ]
    }
  },
  "security": {
    "auth": {
      "selectedType": "gemini-api-key"
    },
    "futureSecurityKey": true
  },
  "theme": "GitHub",
  "futureGeminiKey": {
    "nested": [
      1,
      2
    ]
  },
  "ui": {
    "hideBanner": true
  }
}
<no newline at end of file>
