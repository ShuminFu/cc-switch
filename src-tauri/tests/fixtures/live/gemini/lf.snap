=== .gemini/settings.json ===
{
  "futureGeminiKey": {
    "nested": [
      1,
      2
    ]
  },
  "mcpServers": {
    "docs": {
      "args": [
        "docs-mcp"
      ],
      "command": "uvx"
    }
  },
  "security": {
    "auth": {
      "selectedType": "gemini-api-key"
    },
    "futureSecurityKey": true
  },
  "theme": "GitHub",
  "ui": {
    "hideBanner": true
  }
}
<no newline at end of file>
