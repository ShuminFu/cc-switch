---
source: tests/config_writers.rs
description: "openclaw_mcp writer, crlf input"
---
write: ok
=== .openclaw/openclaw.json ===
{<CR>
  // OpenClaw config written by the user<CR>
  agents: {<CR>
    defaults: {<CR>
      workspace: "~/work", // trailing comment<CR>
    },<CR>
  },<CR>
  mcp: {
    "servers": {
      "remote": {
        "url": "https://new.example.com/mcp",
        "transport": "streamable-http",
        "connectionTimeoutMs": 5000,
        "headers": {
          "Authorization": "Bearer token"
        }
      },
      "user-owned": {
        "command": "uvx",
        "args": [
          "user-owned-mcp"
        ]
      },
      "fetch": {
        "command": "uvx",
        "args": [
          "mcp-server-fetch"
        ],
        "env": {
          "FETCH_TIMEOUT": "30"
        }
      }
    }
  },<CR>
  futureOpenclawKey: {<CR>
    nested: [1, 2],<CR>
  },<CR>
}<CR>
