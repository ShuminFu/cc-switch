{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Core/plugin permissions plus the standard app command domains (see src/commands/registry.rs). Privileged commands are granted separately by capabilities/privileged.json.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "updater:default",
    "core:window:allow-set-skip-taskbar",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-is-maximized",
    "core:window:allow-close",
    "core:window:allow-set-decorations",
    "process:allow-restart",
    "dialog:default",
    "app",
    "settings",
    "config",
    "provider",
    "accounts",
    "mcp",
    "prompt",
    "profile",
    "skill",
    "proxy",
    "usage",
    "sync",
    "sessions",
    "cli-tools",
    "integrations"
  ]
}
