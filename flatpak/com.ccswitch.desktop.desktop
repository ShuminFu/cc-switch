[Desktop Entry]
Type=Application
Name=CC Switch
Comment=All-in-one manager for Claude Code, Claude Desktop, Codex, Gemini CLI, Grok Build, OpenCode, OpenClaw and Hermes Agent
Exec=cc-switch %U
Icon=com.ccswitch.desktop
Terminal=false
Categories=Utility;Development;
# ccswitch:// deep links (deep-link import), same scheme as the other packages.
MimeType=x-scheme-handler/ccswitch;
StartupNotify=true
