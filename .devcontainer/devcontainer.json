{
  // Development container for Codespaces / VS Code Dev Containers (CI-29).
  // Ubuntu 22.04 matches the Linux CI and release images; system packages come
  // from scripts/install-linux-deps.sh (the same list CI installs), Rust from
  // rust-toolchain.toml, Node from .node-version, pnpm from package.json.
  "name": "cc-switch",
  "image": "mcr.microsoft.com/devcontainers/base:jammy",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22.12.0"
    },
    "ghcr.io/devcontainers/features/rust:1": {
      "version": "none",
      "profile": "minimal"
    }
  },
  "postCreateCommand": "bash scripts/install-linux-deps.sh --bundle && rustup toolchain install && corepack enable && corepack install && pnpm install --frozen-lockfile && mkdir -p dist",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": { "label": "Vite dev server (pnpm dev:renderer)" }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "tauri-apps.tauri-vscode",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "EditorConfig.EditorConfig"
      ]
    }
  }
}
